{
  "scopeName": "source.script",
  "name": "SCRIPT",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#charCommand"
    },
    {
      "include": "#menuCommands"
    },
    {
      "include": "#sceneCommand"
    },
    {
      "include": "#displayCommand"
    },
    {
      "include": "#gametitleCommand"
    },
    {
      "include": "#defCommand"
    },
    {
      "include": "#choiceCommands"
    },
    {
      "include": "#general"
    },
    {
      "include": "#dialogue"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.script",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "general": {
      "patterns": [
        {
          "name": "keyword.definition.block.script",
          "match": "^\\s*@\\w+\\b"
        },
        {
          "name": "variable.embedded.script",
          "match": "\\{[^\\}]+\\}"
        }
      ]
    },
    "charCommand": {
      "patterns": [
        {
          "name": "meta.definition.char.script",
          "begin": "^\\s*@char\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.definition.char.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "constant.parameter.definition.char.script",
              "match": "(?<=@char\\s)\\S+"
            },
            {
              "name": "keyword.modifier.definition.char.script",
              "match": "\\bas\\b"
            },
            {
              "name": "string.quoted.definition.char.script",
              "match": "(?<=\\bas\\s)\"(?:\\\\.|[^\"\\\\])*\""
            }
          ]
        }
      ]
    },
    "menuCommands": {
      "patterns": [
        {
          "name": "keyword.control.block.script",
          "match": "^\\s*@mainMenu\\b"
        },
        {
          "name": "meta.event.button.script",
          "begin": "^\\s*@button\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.event.button.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "string.quoted.button.label.script",
              "match": "\"(?:\\\\.|[^\"\\\\])*\""
            },
            {
              "name": "keyword.modifier.button.event.script",
              "match": "\\bevent\\b"
            },
            {
              "name": "meta.event.button.action.script",
              "begin": "(?<=event\\s)",
              "end": "(?=$)",
              "patterns": [
                {
                  "name": "meta.function.event.script",
                  "match": "(\\w+)\\(",
                  "captures": {
                    "1": {
                      "name": "entity.name.function.event.script"
                    }
                  }
                },
                {
                  "name": "string.quoted.event.parameter.script",
                  "match": "\"(?:\\\\.|[^\"\\\\])*\""
                },
                {
                  "name": "punctuation.definition.parentheses.script",
                  "match": "[()]"
                },
                {
                  "name": "constant.language.event.script",
                  "match": "\\b\\w+\\b"
                }
              ]
            }
          ]
        },
        {
          "name": "keyword.control.endmenu.script",
          "match": "^\\s*@endMenu\\b"
        }
      ]
    },
    "choiceCommands": {
      "patterns": [
        {
          "name": "keyword.control.block.script",
          "match": "^\\s*@choice\\b"
        },
        {
          "name": "meta.event.button.script",
          "begin": "^\\s*@option\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.event.button.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "string.quoted.button.label.script",
              "match": "\"(?:\\\\.|[^\"\\\\])*\""
            },
            {
              "name": "keyword.modifier.button.event.script",
              "match": "\\bevent\\b"
            },
            {
              "name": "meta.event.button.action.script",
              "begin": "(?<=event\\s)",
              "end": "(?=$)",
              "patterns": [
                {
                  "name": "meta.function.event.script",
                  "match": "(\\w+)\\(",
                  "captures": {
                    "1": {
                      "name": "entity.name.function.event.script"
                    }
                  }
                },
                {
                  "name": "string.quoted.event.parameter.script",
                  "match": "\"(?:\\\\.|[^\"\\\\])*\""
                },
                {
                  "name": "punctuation.definition.parentheses.script",
                  "match": "[()]"
                },
                {
                  "name": "constant.language.event.script",
                  "match": "\\b\\w+\\b"
                }
              ]
            }
          ]
        },
        {
          "name": "keyword.control.endmenu.script",
          "match": "^\\s*@end_choice\\b"
        }
      ]
    },
    "sceneCommand": {
      "patterns": [
        {
          "name": "meta.definition.scene.script",
          "begin": "^\\s*@scene\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.definition.scene.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "constant.parameter.scene.tag.script",
              "match": "(?<=@scene\\s)\\S+"
            },
            {
              "name": "punctuation.separator.assignment.scene.script",
              "match": "\\s*=\\s*"
            },
            {
              "name": "string.quoted.scene.script",
              "match": "\"(?:\\\\.|[^\"\\\\])*\""
            }
          ]
        }
      ]
    },
    "displayCommand": {
      "patterns": [
        {
          "name": "meta.configuration.display.script",
          "begin": "^\\s*@Display\\(",
          "beginCaptures": {
            "0": {
              "name": "keyword.configuration.display.script"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.display.script"
            }
          },
          "patterns": [
            {
              "name": "constant.numeric.width.display.script",
              "match": "(?<=@Display\\()[0-9]+(?=\\s*,)"
            },
            {
              "name": "punctuation.separator.parameters.display.script",
              "match": "\\s*,\\s*"
            },
            {
              "name": "constant.numeric.height.display.script",
              "match": "(?<=,\\s*)[0-9]+"
            }
          ]
        }
      ]
    },
    "gametitleCommand": {
      "patterns": [
        {
          "name": "meta.configuration.gametitle.script",
          "begin": "^\\s*@GameTitle\\(",
          "beginCaptures": {
            "0": {
              "name": "keyword.configuration.gametitle.script"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.gametitle.script"
            }
          },
          "patterns": [
            {
              "name": "string.quoted.gametitle.script",
              "match": "\"(?:\\\\.|[^\"\\\\])*\""
            }
          ]
        }
      ]
    },
    "defCommand": {
      "patterns": [
        {
          "name": "meta.definition.def.script",
          "begin": "^\\s*@def\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.definition.def.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "constant.parameter.def.variable.script",
              "match": "(?<=@def\\s)\\S+"
            },
            {
              "name": "punctuation.separator.assignment.def.script",
              "match": "\\s*=\\s*"
            },
            {
              "name": "string.quoted.def.value.script",
              "match": "\"(?:\\\\.|[^\"\\\\])*\""
            }
          ]
        }
      ]
    },
    "dialogue": {
      "patterns": [
        {
          "name": "meta.dialogue.colon.script",
          "begin": "^\\s*([^:]+):\\s*",
          "beginCaptures": {
            "1": {
              "name": "entity.name.character.dialogue.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "variable.embedded.script",
              "match": "\\{[^\\}]+\\}"
            },
            {
              "name": "string.unquoted.dialogue.script",
              "match": "[^{}]+"
            }
          ]
        },
        {
          "name": "meta.dialogue.star.script",
          "begin": "^\\s*([^\\s]+)\\*\\s*",
          "beginCaptures": {
            "1": {
              "name": "entity.name.character.dialogue.script"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "variable.embedded.script",
              "match": "\\{[^\\}]+\\}"
            },
            {
              "name": "string.unquoted.dialogue.script",
              "match": "[^{}]+"
            }
          ]
        }
      ]
    }
  }
}