{
  "name": "vne",
  "displayName": "Visual Novel Engine Syntax", 
  "description": "A custom visual novel engine",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "pack": "vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "script",
        "aliases": [
          "SCRIPT"
        ],
        "extensions": [
          ".script"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "script",
        "scopeName": "source.script",
        "path": "./syntaxes/script.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vsce": "^2.15.0"
  }
}
